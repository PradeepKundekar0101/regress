# Copy to .env and fill in. Never commit .env. Do not wrap values in quotes: docker --env-file keeps them literally.

# LLM. Leave OPENAI_BASE_URL empty for api.openai.com; set it to the TrueFoundry
# AI Gateway (https://gateway.truefoundry.ai) and use a gateway token as the key to route through it.
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL=gpt-4.1-mini

# Langfuse Cloud (EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
PROMPT_NAME=adopt-support

# Supabase Postgres connection string (Project Settings > Database > Session pooler URI)
DATABASE_URL=

# PostHog. Capture uses the project API key (phc_..., Settings > Project > General).
# Reading events back (the agent's user-impact signal) needs a personal API key (phx_...)
# with query:read scope, plus the numeric project id from the PostHog URL.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# GitHub repo that records config changes (prompt label, route) as commits.
# GITHUB_TOKEN falls back to `gh auth token` when empty.
CONFIG_REPO=
GITHUB_TOKEN=

# Where the traffic script and fault switches reach the bot
BOT_URL=http://localhost:8000

# Slack approvals (docs/slack-app-manifest.yaml). Bot token xoxb-, app-level token xapp- (Socket Mode),
# channel id C..., optional comma-separated user ids allowed to decide (also the people each new incident pings;
# empty pings @here), and where Slack links to the console.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
SLACK_APPROVERS=
CONSOLE_URL=http://localhost:8100

# Linear (Settings > Security & access > Personal API keys) and the team incident issues go to, by name or key
LINEAR_API_KEY=
LINEAR_TEAM=
